+        // Dynamic-resolution fix: read only the 12-byte shared-memory header.
+        // This avoids copying the frame just to discover its dimensions.
+        public static bool TryGetCaptureSize(out int width, out int height)
+        {
+            width = 0;
+            height = 0;
+
+            if (!IsAvailable())
+                return false;
+
+            try
+            {
+                Screenshot screenshot = (Screenshot)Marshal.PtrToStructure(_shm, typeof(Screenshot));
+
+                if (screenshot.width == 0 || screenshot.height == 0 || screenshot.channels == 0)
+                    return false;
+
+                width = checked((int)screenshot.width);
+                height = checked((int)screenshot.height);
+                return true;
+            }
+            catch (Exception ex)
+            {
+                VideoExport.Logger.LogWarning($"Failed to read KKReshade capture size, falling back to Unity Screen size: {ex.Message}");
+                width = 0;
+                height = 0;
+                return false;
+            }
+        }
